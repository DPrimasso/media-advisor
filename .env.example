TRANSCRIPT_API_KEY=your_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Server / paths (use absolute paths on a dedicated Windows host)
# MEDIA_ADVISOR_ROOT=C:/path/to/media-advisor
# Optional: default is <MEDIA_ADVISOR_ROOT>/data/media_advisor.sqlite (ignored by git)
# MEDIA_ADVISOR_DATABASE_URL=sqlite:////C:/path/outside/onedrive/media_advisor.sqlite
# Optional: also write digest JSON/MD under reports/ (default true)
# MEDIA_ADVISOR_EXPORT_REPORT_FILES=true
# Production: if set, POST /api/sync*, /api/fetch-now require header X-Media-Advisor-Sync
# MEDIA_ADVISOR_SYNC_SECRET=generate-a-long-random-string
# Optional: comma-separated CORS origins (empty = allow all). Example for local Vite + prod host:
# MEDIA_ADVISOR_CORS_ORIGINS=http://localhost:5173,https://your-host.example
# Future (not implemented): global Bearer on mutating routes would require MEDIA_ADVISOR_API_TOKEN + frontend changes
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_THREAD_ID=123456  # opzionale: id topic/thread Telegram
# Report costi post-sync (DM personale): stesso bot, chat_id del tuo utente
# TELEGRAM_PERSONAL_CHAT_ID=
# TELEGRAM_PERSONAL_THREAD_ID=
# Stima costi (USD). Lascia vuoto per mostrare solo token/conteggi senza importo.
# MEDIA_ADVISOR_OPENAI_INPUT_USD_PER_1M=0.15
# MEDIA_ADVISOR_OPENAI_OUTPUT_USD_PER_1M=0.60
# MEDIA_ADVISOR_TRANSCRIPT_API_USD_PER_CALL=0.01
# Optional: uvicorn port for npm run server:prod (run-uvicorn-prod.mjs); default 3002
# PORT=3002
# Optional: Python executable for run-uvicorn-prod.mjs (e.g. venv on Windows)
# PYTHON=C:/path/to/media-advisor/.venv/Scripts/python.exe
